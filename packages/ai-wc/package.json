{
  "name": "@zeus-web/ai-wc",
  "type": "module",
  "version": "0.1.0-beta.35",
  "description": "Web Component adapter for Zeus AI Headless V2: zw-ai-* custom elements, registered on demand, light DOM, property-only data.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/baicie/zeus-ui.git",
    "directory": "packages/ai-wc"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": [
    "./dist/define.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "import": "./dist/define.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup src/index.ts src/define.ts --format esm --dts --clean --watch",
    "build": "tsup src/index.ts src/define.ts --format esm --dts --clean",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --root ../.. --project unit-jsdom packages/ai-wc/__tests__"
  },
  "dependencies": {
    "@zeus-web/ai-core": "workspace:*",
    "@zeus-web/ai-primitives": "workspace:*"
  }
}
