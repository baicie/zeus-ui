{
  "extends": "../../scripts/config/tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "jsx": "preserve",
    "jsxImportSource": "@zeus-js/zeus",
    "paths": {
      "@zeus-web/*/react": [
        "../../packages/primitives/*/dist/react/index.d.ts",
        "../../packages/advanced/*/dist/react/index.d.ts"
      ],
      "@zeus-web/*/vue": [
        "../../packages/primitives/*/dist/vue/index.d.ts",
        "../../packages/advanced/*/dist/vue/index.d.ts"
      ],
      "react": [
        "../../examples/vite-react/node_modules/@types/react/index.d.ts"
      ],
      "react/jsx-runtime": [
        "../../examples/vite-react/node_modules/@types/react/jsx-runtime.d.ts"
      ],
      "react-dom/client": [
        "../../examples/vite-react/node_modules/@types/react-dom/client.d.ts"
      ],
      "@zeus-web/*": [
        "../../packages/*/src",
        "../../packages/primitives/*/src",
        "../../packages/advanced/*/src"
      ]
    },
    "types": ["node", "vitest/globals"],
    "noEmit": true,
    "isolatedDeclarations": false,
    "skipLibCheck": true
  },
  "include": ["*.ts", "*.tsx", "../../scripts/config/jsx.d.ts"]
}
