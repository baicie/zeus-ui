{
  "extends": "./scripts/config/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "jsxImportSource": "@zeus-js/zeus",
    "module": "ESNext",
    "types": ["vitest/globals", "node"],
    "noEmit": true,
    "outDir": "temp",
    "isolatedDeclarations": false,
    "skipLibCheck": true
  },
  "include": [
    "scripts/config/jsx.d.ts",
    "packages/*/src",
    "packages/primitives/*/src",
    "packages/advanced/*/src",
    "packages/advanced/*/benchmarks",
    "packages/*/__tests__",
    "packages/primitives/*/__tests__",
    "packages/advanced/*/__tests__",
    "scripts/**/*",
    "apps/**/*",
    "apps/docs/.vitepress/**/*",
    "examples/showcase-shared/src/**/*",
    "examples/ai-host/src/**/*",
    "examples/ai-host/__tests__/**/*",
    "examples/ai-workbench/src/**/*",
    "e2e/**/*"
  ],
  "exclude": [
    "packages/zeus-compat/__tests__/canary-capabilities.spec.ts",
    "e2e/advanced/data-grid/framework-renderer/**",
    "e2e/advanced/data-grid/framework-renderer-browser.spec.ts"
  ]
}
