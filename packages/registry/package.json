{
  "name": "@zeus-web/registry",
  "type": "module",
  "version": "0.1.0-beta.32",
  "description": "Source component registry templates for Zeus Web.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/baicie/zeus-ui.git",
    "directory": "packages/registry"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./registry.json": "./dist/registry.json",
    "./quality": {
      "types": "./dist/quality.d.ts",
      "import": "./dist/quality.js"
    },
    "./quality.json": "./dist/quality.json",
    "./components.json": "./dist/components.json",
    "./templates/react/*": "./dist/templates/react/*",
    "./templates/vue/*": "./dist/templates/vue/*",
    "./templates/css/globals.css": "./dist/templates/css/globals.css",
    "./templates/lib/cn.ts": "./dist/templates/lib/cn.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup src/index.ts src/schema.ts --format esm --dts --clean --watch",
    "generate:components": "node scripts/generate-component-contracts.mjs",
    "check:components": "node scripts/generate-component-contracts.mjs --check",
    "build": "pnpm generate:components && tsup src/index.ts src/schema.ts src/quality.ts --format esm --dts --clean && node scripts/copy-registry-assets.mjs",
    "check": "tsc -p tsconfig.json --noEmit && pnpm check:components",
    "test": "vitest --root ../.. --project unit packages/registry/__tests__/registry-package.spec.ts"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
