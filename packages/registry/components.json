{
  "schemaVersion": 1,
  "components": [
    {
      "name": "button",
      "primitive": "@zeus-web/button",
      "description": "Styled button component built on top of the button primitive.",
      "variants": {
        "variant": {
          "type": "ButtonVariant",
          "values": [
            "default",
            "primary",
            "secondary",
            "outline",
            "ghost",
            "danger"
          ],
          "default": "default",
          "description": "Visual style variant."
        },
        "size": {
          "type": "ButtonSize",
          "values": ["sm", "md", "lg", "icon"],
          "default": "md",
          "description": "Control size."
        },
        "type": {
          "type": "ButtonType",
          "values": ["button", "submit", "reset"],
          "default": "button",
          "description": "Native button type."
        }
      },
      "props": [
        {
          "name": "variant",
          "variant": "variant",
          "description": "Visual style variant."
        },
        {
          "name": "size",
          "variant": "size",
          "description": "Control size."
        },
        {
          "name": "type",
          "variant": "type",
          "description": "Native button type."
        },
        {
          "name": "className",
          "type": "string",
          "frameworks": ["react"],
          "description": "Additional React class name."
        },
        {
          "name": "class",
          "type": "string",
          "frameworks": ["vue"],
          "description": "Additional Vue class name."
        },
        {
          "name": "ariaLabel",
          "type": "string",
          "description": "Accessible label for the button."
        },
        {
          "name": "disabled",
          "type": "boolean",
          "default": false,
          "description": "Whether the button is disabled."
        },
        {
          "name": "loading",
          "type": "boolean",
          "default": false,
          "description": "Whether the button is loading."
        },
        {
          "name": "name",
          "type": "string",
          "description": "Native button name."
        },
        {
          "name": "pressed",
          "type": "boolean",
          "default": false,
          "description": "Whether the button is pressed."
        },
        {
          "name": "value",
          "type": "string",
          "description": "Native button value."
        }
      ],
      "events": [
        {
          "name": "press",
          "reactName": "onPress",
          "vueName": "press",
          "type": "CustomEvent<{ nativeEvent: MouseEvent }>",
          "description": "Emitted when the button is pressed."
        }
      ],
      "slots": [
        {
          "name": "prefix",
          "types": {
            "react": "ReactNode",
            "vue": "() => unknown"
          },
          "description": "Content before the button label."
        },
        {
          "name": "default",
          "types": {
            "react": "ReactNode",
            "vue": "() => unknown"
          },
          "description": "Button content."
        },
        {
          "name": "suffix",
          "types": {
            "react": "ReactNode",
            "vue": "() => unknown"
          },
          "description": "Content after the button label."
        }
      ]
    },
