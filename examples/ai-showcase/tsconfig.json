{
  "compilerOptions": {
    "composite": false,
    "target": "ES2020",
    "jsx": "react-jsx",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@zeus-web/ai-primitives/extensions": [
        "../../packages/ai-primitives/src/extensions/index.ts"
      ],
      "@zeus-web/ai-wc/define": ["../../packages/ai-wc/src/define.ts"],
      "@zeus-web/*": ["../../packages/*/src/index.ts"]
    },
    "types": ["vite/client"],
    "strict": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedDeclarations": false,
    "skipLibCheck": true
  },
  "include": ["src", "vite.config.ts"]
}
